# === AdGuard Home ===
ADGUARD_URL=http://192.168.1.1:3000
ADGUARD_USER=admin
ADGUARD_PASS=your_password

# === Resend Email ===
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=AdGuard Reports <informes@tudominio.com>
EMAIL_TO=tu@email.com
# Multiple recipients separated by comma: user1@mail.com,user2@mail.com

# === Schedule ===
CRON_SCHEDULE=0 6 * * *
TZ=America/Bogota

# === Report Settings ===
REPORTS_DIR=/app/reports
QUERYLOG_HOURS=24
QUERYLOG_LIMIT=5000
TOP_DOMAINS_COUNT=20
LOG_LEVEL=INFO

# === Optional: Run immediately on container start ===
RUN_ON_START=true
